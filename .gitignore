# SanDisk firmware and anything extracted from it: never commit
*.hex
*.afi
*.FW
out/
out116/
fw116/
check/

# third-party source trees used for reference
rb/

# build products
*.o
*.elf
*.bin
*.lst
*.dSYM/
programs/host_raiders
programs/host_frames/
programs/preview_test/
programs/src/
